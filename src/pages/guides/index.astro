---
import "../../styles/text-sections.css";
import "../../styles/cards.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Img from "../../components/Img.astro";
import { getGuidesPage } from "../../lib/guides";

const p = await getGuidesPage();
---

<BaseLayout
  title={p.seo?.title ?? p.intro?.heading}
  description={p.seo?.description}
  image={p.seo?.image}
>
  <main>
    {
      p.intro && (
        <section class="page-intro">
          <div class="container">
            <h1>{p.intro.heading}</h1>
            {p.intro.paragraphs.map((t) => (
              <p>{t}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      p.guides.length > 0 && (
        <section class="section">
          <div class="container">
            {p.guidesHeading && (
              <div class="cards-head">
                <h2>{p.guidesHeading}</h2>
              </div>
            )}
            <div class="guides-grid">
              {p.guides.map((g) => (
                <article class="info-card guide-card glass-card" data-scroll>
                  <a
                    class="guide-cover"
                    href={`/guides/${g.slug}`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <Img
                      class="img-fx"
                      image={{ ...g.cover, decorative: true }}
                      width={600}
                      height={800}
                    />
                  </a>
                  <h3>{g.title}</h3>
                  {g.shortDescription && <p>{g.shortDescription}</p>}
                  <a class="btn btn-sm" href={`/guides/${g.slug}`}>
                    Learn More
                    <span class="visually-hidden"> about {g.title}</span>
                  </a>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
