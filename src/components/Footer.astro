---
import { urlFor } from "../lib/sanity";
import type { SiteSettings } from "../lib/site";

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/">
          {
            site.footerLogo ? (
              <img
                src={urlFor(site.footerLogo).height(120).auto("format").url()}
                alt={site.brandName}
              />
            ) : (
              site.brandName
            )
          }
        </a>
        {site.footerText && <p class="footer-tagline">{site.footerText}</p>}
        {
          site.socials.length > 0 && (
            <ul class="footer-social" aria-label="Social media">
              {site.socials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${site.brandName} on ${s.platform}`}
                  >
                    {s.platform}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="footer-links" aria-label="Footer">
        {
          site.footerColumns.map((col) => (
            <div class="footer-col">
              <h2 class="footer-heading">{col.heading}</h2>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.newTab ? "_blank" : undefined}
                      rel={l.newTab ? "noopener noreferrer" : undefined}
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer-bottom">
      <p>
        © {year}{" "}
        {site.brandName}. {" "}
        <span class="footer-credit">
          Designed by <a
            href="https://dqheard.com/utm_source=bms"
            target="_blank"
            rel="noopener">D. Heard</a
          >
        </span>
      </p>
      <a class="back-to-top" href="#">Back to Top ↑</a>
    </div>
  </div>
</footer>
